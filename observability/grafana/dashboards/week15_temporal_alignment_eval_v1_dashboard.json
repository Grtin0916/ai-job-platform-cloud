      ],
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 8
      }
    },
    {
      "id": 6,
      "type": "text",
      "title": "Scope Boundaries",
      "options": {
        "mode": "markdown",
        "content": "Dashboard-ready only. No live Grafana import, no production SLO, no human-review pass, no semantic audio quality pass, no final mix readiness, no real cloud deployment."
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 8
      }
    }
