===== alerts.yaml before =====
groups:
  - name: week10-local-slo-alerts
    rules:
      - alert: JavaAppTargetDown
        expr: up{job=~".*java.*|.*media.*"} == 0
        for: 2m
        labels:
          severity: warning
          scope: local-dev
        annotations:
          summary: "Java media task target is down"
          description: "Prometheus target {{ $labels.job }} has been down for more than 2 minutes in local dev."

      - alert: JavaAppHighErrorRatio
        expr: |
          (
            sum(rate(http_server_requests_seconds_count{status=~"5.."}[5m]))
            /
            clamp_min(sum(rate(http_server_requests_seconds_count[5m])), 1)
          ) > 0.05
        for: 5m
        labels:
          severity: warning
          scope: local-dev
        annotations:
          summary: "High Java app 5xx error ratio in local dev"
          description: "5xx request ratio is above 5% for 5 minutes. Verified against live Actuator labels: status, method, uri, outcome, exception, error."

      - alert: JavaAppHighMeanLatency
        expr: |
          (
            (
              sum(rate(http_server_requests_seconds_sum{uri!="/actuator/prometheus"}[5m]))
              /
              sum(rate(http_server_requests_seconds_count{uri!="/actuator/prometheus"}[5m]))
            ) > 1
          )
          and
          (
            sum(rate(http_server_requests_seconds_count{uri!="/actuator/prometheus"}[5m])) > 0
          )
        for: 5m
        labels:
          severity: warning
          scope: local-dev
        annotations:
          summary: "High Java app mean latency in local dev"
          description: "Mean request latency is above 1 second for 5 minutes. P95 is deferred because live Actuator evidence exposes summary count/sum/max but no http_server_requests_seconds_bucket."

